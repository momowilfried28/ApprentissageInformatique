<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Apprentissage Informatique</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar">
            <div class="container">
                <form class="d-flex justify-content-center gap-3 w-100">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-success">Accueil</a>
                    <a asp-controller="Home" asp-action="Apropos" class="btn btn-outline-secondary">Qui sommes nous ?</a>


                </form>
            </div>
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer>
        <div class="container">
            <p>&copy; 2026 - Apprentissage Informatique CENTRE ALPHA- Tous droits réservés</p>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
