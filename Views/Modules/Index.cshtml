@model List<ApprentissageInformatique.Models.Module>
@{
    ViewData["Title"] = "Modules";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/modules.css" asp-append-version="true" />
}

<div class="modules-page-header">
    <div class="container">
        <h1>Tous les Modules</h1>
        <p class="lead">Explorez tous les modules d'apprentissage disponibles</p>
    </div>
</div>

<div class="container">
    <div class="modules-grid">
        @foreach (var module in Model)
        {
            <div class="module-card" style="border-top-color: @module.Couleur;">
                <div class="module-icon">@module.Icone</div>
                <h2>@module.Titre</h2>
                <p>@module.Description</p>
                <div class="module-actions">
                    <a href="@module.PdfPath" target="_blank" class="btn btn-primary">
                        Voir le PDF
                    </a>
                    <a asp-action="Quiz" asp-route-id="@module.Id" class="btn btn-secondary">
                        Quiz
                    </a>
                </div>
            </div>
        }
    </div>
</div>
