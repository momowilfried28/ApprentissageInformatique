@model List<ApprentissageInformatique.Models.Module>
@{
    ViewData["Title"] = "Accueil";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

<div class="stars-background"></div>

<div class="hero">
    <div class="hero-banner">
        <div class="hero-overlay"></div>
    </div>
    <div class="hero-content">
        <div class="container">
            <h1>Parcours d'initiation à l'informatique au CENTRE ALPHA</h1>
            <p class="lead">Découvrez des modules pour apprendre les bases de l'informatique</p>
        </div>
    </div>
</div>

<div class="container">
    <div class="modules-grid">
        @foreach (var module in Model)
        {
            <div class="module-card" style="border-top-color: @module.Couleur;">
                <div class="module-icon">
                    <img src="@Url.Content("~/images/ux.png")" alt="@module.Titre" />
                </div>
                <h2>@module.Titre</h2>
                <p>@module.Description</p>
                <div class="module-actions">
                    <a href="@module.PdfPath" target="_blank" class="btn btn-primary">
                        Voir le PDF
                    </a>
                    <a asp-controller="Modules" asp-action="Quiz" asp-route-id="@module.Id" class="btn btn-secondary">
                        Quiz
                    </a>
                </div>
            </div>
        }
    </div>
</div>
