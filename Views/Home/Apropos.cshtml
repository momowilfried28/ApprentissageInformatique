@{
    ViewData["Title"] = "À propos";
}

@section Styles {
    <link rel="stylesheet" href="~/css/about.css" asp-append-version="true" />
}

<div class="about-page-header">
    <div class="container">
        <h1>Qui sommes nous ?</h1>
    </div>
</div>

<div class="container">
    <div class="about-content">
        <div class="about-section">
            <h2>Bienvenue au CENTRE ALPHA</h2>
            <p>
                Le CENTRE ALPHA propose un parcours d'initiation à l'informatique conçu pour vous accompagner 
                dans l'apprentissage des bases essentielles de l'informatique. Notre mission est de rendre 
                l'informatique accessible à tous, quel que soit votre niveau de départ.
            </p>
        </div>

        <div class="about-section">
            <h2>Notre mission</h2>
            <p>
                Nous croyons que l'informatique est un outil puissant qui peut améliorer la vie quotidienne 
                et ouvrir de nouvelles opportunités. Notre objectif est de vous donner les compétences 
                nécessaires pour utiliser un ordinateur en toute confiance.
            </p>
        </div>

        <div class="about-section">
            <h2>Les Modules d'apprentissage</h2>
            <p>
                Notre parcours comprend plusieurs modules interactifs couvrant les aspects fondamentaux 
                de l'informatique :
            </p>
            <ul class="about-list">
                <li><strong>Initiation à l'ordinateur</strong> </li>
                <li><strong>Navigation sur Internet</strong> </li>
                <li><strong>Messagerie et communication</strong> </li>
                <li><strong>Nettoyage et protection du PC</strong></li>
            </ul>
        </div>

        <div class="about-section">
            <h2>Comment utiliser ce parcours</h2>
            <p>
                Chaque module comprend :
            </p>
            <ul class="about-list">
                <li>Un document PDF avec le contenu du cours</li>
                <li>Un quiz interactif pour tester vos connaissances</li>
                <li>Des explications claires et accessibles</li>
            </ul>
            <p>
                Prenez votre temps, lisez les documents à votre rythme et testez vos connaissances avec les quiz.

            </p>
        </div>

        <div class="about-section">
            <h2>Contact</h2>
            <p>
                Pour toute question ou assistance, n'hésitez pas à nous contacter au CENTRE ALPHA.
                <h5>📞450-378-9788 </h5>
                <h5>
                    <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" fill="currentColor" class="bi bi-facebook" viewBox="0 0 16 16">
                    <path d="M16 8.049c0-4.446-3.582-8.05-8-8.05C3.58 0-.002 3.603-.002 8.05c0 4.017 2.926 7.347 6.75 7.951v-5.625h-2.03V8.05H6.75V6.275c0-2.017 1.195-3.131 3.022-3.131.876 0 1.791.157 1.791.157v1.98h-1.009c-.993 0-1.303.621-1.303 1.258v1.51h2.218l-.354 2.326H9.25V16c3.824-.604 6.75-3.934 6.75-7.951" />
       
                </svg>
                  Centre Alpha</h5>
            </p>
        </div>
    </div>
</div>
