<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Apprentissage Informatique</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                     Parcours d'Initiation à l'Informatique
                </a>
                <ul class="navbar-nav">
                    <li><a asp-controller="Home" asp-action="Index">Accueil</a></li>
                    <li><a asp-controller="Modules" asp-action="Index">Modules</a></li>
                </ul>
            </div>
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer>
        <div class="container">
            <p>&copy; 2026 - Apprentissage Informatique CENTRE ALPHA- Tous droits réservés</p>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
