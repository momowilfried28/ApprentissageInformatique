<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Apprentissage Informatique</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    Parcours d'Initiation à l'Informatique
                </a>
                <form class="container-fluid justify-content-start">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-success me-2">Accueil</a>
                    <a asp-controller="Modules" asp-action="Index" class="btn btn-sm btn-outline-secondary">Modules</a>
                </form>
            </div>
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer>
        <div class="container">
            <p>&copy; 2026 - Apprentissage Informatique CENTRE ALPHA- Tous droits réservés</p>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
